# Copy to .env.local for local dev. Never commit real values.
# All of these are SERVER-ONLY (no NEXT_PUBLIC_ prefix) except the site key.

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET=your-turnstile-secret
# Local-only test keys from Cloudflare's docs (always pass):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Production hostname(s) Turnstile must report (comma-separated). localhost is
# only accepted when NODE_ENV !== "production".
SITE_HOSTNAME=example.org,www.example.org

# Contact info revealed after the check
CONTACT_EMAIL=hello@example.org
CONTACT_PHONE=(555) 555-5555
# Per-card contacts for /contact, keyed by card id:
CONTACTS_JSON={"irvine":{"email":"a@example.org","phone":"(555) 555-5555"},"new-york":{},"bay-area":{},"toronto":{},"mission-viejo":{},"designer":{}}

# Upstash rate limiting (Vercel injects the KV_* names; unset locally = limiting skipped with a warning)
KV_REST_API_URL=
KV_REST_API_TOKEN=
